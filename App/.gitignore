# The root .gitignore drops any `models/` directory (weights); app source
# folders named Models are code, so re-include them.
!Sources/**/Models/
!Tests/**/Models/

# It also drops any `notes/` directory (program notes), which on a
# case-insensitive file system matches the app's Notes source folders.
!Sources/**/Notes/
!Tests/**/Notes/

# Scripts/bundle.sh output (Mference.app).
/build/
