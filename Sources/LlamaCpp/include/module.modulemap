// The C API of the vendored llama.cpp and its multimodal library (mtmd.h),
// plus our MTP shim (mference_mtp.h).
// The C++-only headers in this directory (llama-cpp.h, ggml-cpp.h) are
// deliberately not part of the module.
module LlamaCpp {
    header "ggml.h"
    header "ggml-alloc.h"
    header "ggml-backend.h"
    header "ggml-cpu.h"
    header "ggml-metal.h"
    header "ggml-opt.h"
    header "gguf.h"
    header "llama.h"
    header "mtmd.h"
    header "mference_mtp.h"
    export *
}
